# =============================================================
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA vai pro GitHub (está no .gitignore).
# =============================================================

# --- Banco de dados Neon -------------------------------------
# Painel do Neon > Connection Details > copie a "Connection string".
# IMPORTANTE: gere uma senha NOVA (Roles > Reset password) antes de usar,
# porque a senha antiga estava exposta dentro do HTML.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Segurança -----------------------------------------------
# Chave usada para assinar o login do admin. Gere uma aleatória com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-uma-chave-aleatoria-bem-longa

# Login do painel administrativo (usado por: npm run setup:db)
ADMIN_EMAIL=dulcerecordatio@gmail.com
ADMIN_SENHA=troque-esta-senha

# --- Mercado Pago --------------------------------------------
# Painel do Mercado Pago > Suas integrações > Credenciais de produção.
# Sem isso a loja continua funcionando, mas cai no link de pagamento estático.
MP_ACCESS_TOKEN=
# Link estático de fallback (o que você já usava)
MP_LINK_FALLBACK=https://link.mercadopago.com.br/dulcerecordation

# --- Site ----------------------------------------------------
# URL pública do site. Em produção troque para o domínio real,
# senão o Mercado Pago não consegue devolver o cliente pra loja.
SITE_URL=http://localhost:3000
PORT=3000

# --- Regras de negócio ---------------------------------------
# Pedidos acima deste valor ganham frete grátis (0 = desativado)
FRETE_GRATIS_ACIMA=250
